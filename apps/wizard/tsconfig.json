{
  "extends": "@apollo/typescript-config/script.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*", "./cli/*", "./generator/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "cli/**/*.ts",
    "generator/**/*.ts",
    "scripts/**/*.ts",
    "__tests__/**/*.ts",
    "build.ts",
    "template.ts"
  ]
}
