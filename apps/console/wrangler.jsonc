{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apollo-console",
  "compatibility_date": "2026-08-05",
  "routes": [{ "pattern": "heyapollo.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
