{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "types": {
      "cache": true,
      "inputs": ["wrangler.jsonc"],
      "outputs": ["worker-configuration.d.ts"]
    },
    "typecheck": {
      "dependsOn": ["types"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["types"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["types"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"]
    },
    "deploy": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"]
    }
  }
}
