{
  "extends": ["agents/tsconfig"],
  "compilerOptions": {
    "types": ["bun"],
    "lib": ["es2023"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },


  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
